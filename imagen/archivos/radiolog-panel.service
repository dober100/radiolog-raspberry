[Unit]
Description=RadioLog: página de datos (http://radiolog.local)
After=network.target

[Service]
User=radiolog
Group=radiolog
StateDirectory=radiolog
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/radiolog/radiolog_panel.py --puerto 80
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
